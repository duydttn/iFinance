{
  "name": "ifinance",
  "version": "1.2.4",
  "description": "Intelligent Internal Income and Expense Management System",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "cross-env ELECTRON_RUN_AS_NODE=1 electron backend/server.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run client\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:ui": "cd client && npm run build",
    "build": "npm run build:ui && electron-builder",
    "build:win": "npm run build:ui && electron-builder --win",
    "build:mac": "npm run build:ui && electron-builder --mac",
    "build:linux": "npm run build:ui && electron-builder --linux",
    "build:report": "powershell -ExecutionPolicy Bypass -File scripts/build-report.ps1",
    "build:report:template": "powershell -ExecutionPolicy Bypass -File scripts/build-report.ps1 -CreateReferenceTemplate"
  },
  "keywords": [
    "finance",
    "expense",
    "income",
    "management",
    "electron"
  ],
  "author": "vzdev",
  "license": "MIT",
  "dependencies": {
    "@journeyapps/sqlcipher": "^5.3.1",
    "adm-zip": "^0.5.16",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-telegram-bot-api": "^0.67.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "systeminformation": "^5.31.5",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.ifinance.app",
    "productName": "iFinance",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "!backend/public/updates/**/*",
      "client/dist/**/*",
      "frontend/assets/**/*",
      "package.json",
      "!release/**/*",
      "!node_modules/.cache/**/*",
      "!backup/**/*",
      "!dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "frontend/assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "frontend/assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "frontend/assets/icon.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://localhost:3000/updates"
      }
    ]
  }
}
